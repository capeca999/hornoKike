# ---- Copia estas variables en Vercel → Settings → Environment Variables ----

# Contraseña para entrar en /admin (pon una larga)
ADMIN_PASSWORD=

# Texto aleatorio largo para firmar las sesiones (cualquier cadena de 32+ caracteres)
ADMIN_SECRET=

# Captcha del login (Cloudflare Turnstile). Si las dejas vacías, el panel funciona sin captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública del bucket, p. ej. https://pub-xxxxxxxx.r2.dev  o  https://media.fornalmenar.com
R2_PUBLIC_URL=

# Solo para probar en tu ordenador sin R2 (npm run dev):
# LOCAL_STORAGE_DIR=./.local-storage
